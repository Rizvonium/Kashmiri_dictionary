{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/translate.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/koshurlex",
      "destination": "/#write",
      "permanent": false
    },
    {
      "source": "/koshurlex.html",
      "destination": "/#write",
      "permanent": false
    }
  ]
}